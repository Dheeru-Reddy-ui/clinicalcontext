# ClinicalContext AI — environment template.
# Copy to `.env` at the repo root:  cp .env.example .env
# The backend reads this file directly (backend/.env overrides it if present).
# ALL variables without a default in app/config.py are REQUIRED AT BOOT —
# the backend refuses to start if one is missing (fail-fast contract).
# Keys marked "wired in Phase N" may hold placeholder values until that phase.

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# One of: local | staging | production
ENVIRONMENT=local
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed by CORS. If you run the dev
# server on a non-default port (see "Port conflicts" in the README), add that
# origin here.
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Data stores — exercised from Phase 1 (/ready probes both)
# ------------------------------------------------------------------------------
# Local: the docker-compose Postgres (user/password/db all "clinicalcontext").
# Deployed: the Supabase connection string (Settings > Database) — use the
# DIRECT/session-mode string (port 5432) for migrations; the transaction
# pooler (6543) cannot run them.
DATABASE_URL=postgresql://clinicalcontext:clinicalcontext@localhost:5432/clinicalcontext
# Local: the docker-compose Redis. Deployed: the Upstash URL (rediss://...).
# Also backs rate limiting, the semantic cache, and Idempotency-Key storage.
REDIS_URL=redis://localhost:6379/0

# Which AI backend the graph, embedder and reranker use.
#   offline — deterministic heuristic reasoner + local embedder/reranker. No
#             paid calls, so recorded cost is a truthful $0. Runs with
#             placeholder keys; this is what CI and the test suite use.
#   cloud   — Claude + Cohere. Requires real ANTHROPIC_API_KEY / COHERE_API_KEY,
#             and is what makes the cost figures non-zero.
AI_BACKEND=offline

# ------------------------------------------------------------------------------
# Supabase — wired in Phase 2 (auth, RLS, storage). https://supabase.com/dashboard
# ------------------------------------------------------------------------------
# Project URL (Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key (safe for browsers; RLS enforces access).
SUPABASE_ANON_KEY=placeholder-until-phase-2
# The service-role key (server-only; bypasses RLS — never ship to a client).
SUPABASE_SERVICE_ROLE_KEY=placeholder-until-phase-2
# OPTIONAL — only for legacy projects still signing JWTs with the shared
# HS256 secret (Settings > API > JWT Settings). Projects on asymmetric
# signing keys (the default since 2025) are verified via JWKS; leave unset.
# SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# AI providers — wired from Phase 3 onward
# ------------------------------------------------------------------------------
# Cohere (embed-v4.0 + rerank-v3.5). https://dashboard.cohere.com/api-keys
COHERE_API_KEY=placeholder-until-phase-3
# Anthropic Claude (generation, grading, verification). https://console.anthropic.com
ANTHROPIC_API_KEY=placeholder-until-phase-3
# LangSmith (tracing every graph run). https://smith.langchain.com
LANGSMITH_API_KEY=placeholder-until-phase-3

# Free language models for the chat assistant (and the Ask graph's writing
# step). Any OpenAI-compatible endpoint; each is used only when its key is
# real, in LLM_PROVIDER_ORDER, and a provider at its rate limit hands the
# request to the next. None set: answers are quoted from the sources.
# Groq (free, no card: gpt-oss-120b). https://console.groq.com/keys
# GROQ_API_KEY=
# Cerebras (free, no card, 1M tokens a day). https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# A local or other OpenAI-compatible server, e.g. Ollama:
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Voice pipeline — wired in Phase 11
# ------------------------------------------------------------------------------
# VOICE_BACKEND=offline runs the whole cascade on local engines — faster-whisper
# for STT and the OS speech synthesizer (Windows OneCore / espeak-ng) for TTS —
# with no accounts; `uv sync --group voice` installs them. VOICE_BACKEND=cloud
# uses Deepgram nova-3-medical + ElevenLabs Flash and needs both keys below.
VOICE_BACKEND=offline
# Deepgram nova-3-medical streaming STT. https://console.deepgram.com
DEEPGRAM_API_KEY=placeholder-until-phase-11
# ElevenLabs Flash streaming TTS. https://elevenlabs.io
ELEVENLABS_API_KEY=placeholder-until-phase-11
# ElevenLabs voice id (cloud) and the local voice name (offline).
# VOICE_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# VOICE_OFFLINE_VOICE=Microsoft George
# Offline STT: faster-whisper model (tiny.en is the latency setting, base.en the
# accuracy setting — evals/results/voice.json carries the measured trade-off)
# and the CPU threads per decode (0 = library default; the physical core
# count decoded ~12% faster than the default on an 8-core/16-thread CPU).
# VOICE_WHISPER_MODEL=tiny.en
# VOICE_WHISPER_THREADS=0
# Turn-taking and speculation thresholds (11C, 11D) — defaults shown.
# VOICE_ENDPOINT_SILENCE_MS=300
# VOICE_ENDPOINT_EXTENDED_MS=1500
# VOICE_ENDPOINT_CEILING_MS=2000
# VOICE_SPECULATION_MIN_WORDS=6
# VOICE_SPECULATION_STABLE_MS=300
# VOICE_SPECULATION_SIMILARITY=0.9
# VOICE_LASA_CONFIDENCE_FLOOR=0.6

# ------------------------------------------------------------------------------
# docker-compose overrides (optional — defaults shown; used by compose only)
# ------------------------------------------------------------------------------
# POSTGRES_USER=clinicalcontext
# POSTGRES_PASSWORD=clinicalcontext
# POSTGRES_DB=clinicalcontext
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Observability (Phase 13) — all optional; empty means off.
# ------------------------------------------------------------------------------
# Stamped on every trace, log line and Sentry event. The deploy sets the SHA
# (Render's RENDER_GIT_COMMIT is adopted automatically when RELEASE is unset).
# RELEASE=dev
# OTLP/HTTP endpoint for traces: `docker compose --profile observability up -d`
# runs Jaeger at http://localhost:4318 (UI at :16686). "console" prints spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=clinicalcontext-api
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# Weekly digest email (Phase 13): SMTP host, or empty for in-app only. The
# Supabase CLI's mailpit listens on 127.0.0.1:54325 with no auth — but only
# once `smtp_port = 54325` is uncommented under [local_smtp] in
# supabase/config.toml and the stack is restarted (`supabase stop && start`).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_FROM=ClinicalContext <digest@clinicalcontext.local>
# APP_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Deployment without a worker process (Phase 14.5, the free tier)
# ------------------------------------------------------------------------------
# Deliveries are queued by API requests, so the API is awake whenever there
# is something to deliver. A positive interval makes the API drain its own
# webhook queue every N seconds; 0 (the default) leaves that to the worker
# (`worker-entrypoint.sh` / `scripts.jobs deliver-webhooks`).
# WEBHOOK_DRAIN_INTERVAL_SECONDS=0
